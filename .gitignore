# Dependencies. Only the dev tools have any; the app itself has none at runtime.
node_modules/
tools/node_modules/

# Build reports, regenerated by `node tools/build.mjs`.
MISSING-TH.txt

# Stray output if tools/plate-preview.mjs is run without an output directory.
plate-*.png
plate-*.pdf

# OS noise.
.DS_Store

# Deliberately NOT ignored, so nobody "cleans them up":
#   vendor/noble.js        committed unminified so the vendored crypto stays auditable
#   SHA256SUMS             published with each release, and compared against in Settings
#   docs/screenshots/      the README shows the real app, not mockups
#   tools/package-lock.json  pins the exact dependency versions
